# ------------------------------------------------------------------
# Zeisnet — Apache/cPanel configuration for the static Next.js export
# This file is copied into out/ at build time and must live in
# public_html alongside the exported site.
# ------------------------------------------------------------------

# ---------- Canonical host: force HTTPS and non-www ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> non-www (keep https)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- Redirects from the old website's URLs ----------
RedirectPermanent /our-packages /packages/
RedirectPermanent /service-request /contact/

# ---------- Custom error page ----------
ErrorDocument 404 /404.html

# ---------- Correct MIME types ----------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
</IfModule>

# Next.js metadata routes are extensionless files — force their types
<Files "icon">
  ForceType image/png
</Files>
<Files "opengraph-image">
  ForceType image/png
</Files>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>

# ---------- Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML: always revalidate so deploys show immediately
  ExpiresByType text/html "access plus 0 seconds"
  # Hashed build assets: cache forever
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Immutable caching for Next's content-hashed assets
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---------- Block directory listings ----------
Options -Indexes
